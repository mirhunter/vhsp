[Unit]
Description=VHSP tenant backup config/on-demand reconciler
After=network-online.target docker.service vhsp-docker-proxy.service
Wants=network-online.target vhsp-docker-proxy.service

[Service]
Type=oneshot
User=__VHSP_USER__
Group=__VHSP_USER__
WorkingDirectory=__VHSP_HOME__/vhsp-control-plane
# Talks to Docker through vhsp-docker-proxy.service's scoped API, not the
# raw socket -- see vhsp-admin.service's own comment and the control-plane
# README's "Docker socket exposure" section for the full reasoning.
Environment=VHSP_DOCKER_HOST=tcp://127.0.0.1:2375
# Only needed for the tenant-destination push path (a tenant's own
# backup_dest_* fields, set via tenant-admin's Backups page and read
# straight from the registry) -- these are NOT the operator destination's
# own env vars, images/tenant-admin/app.py has no host access at all and
# never reads these directly; see backup.py's process_requests docstring
# and architecture.md's "Backups per tenant" section for the full
# request-file-plus-reconciler shape this exists to drive.
# Deployment-specific: blank on purpose, filled in per host. The installed
# copy under /etc/systemd/system will diverge from this file permanently as
# a result -- **never reinstall this unit by copying the repo version over a
# running deployment**, or the destination is silently blanked. Diff first
# and carry the values across by hand.
#
# These must be set HERE even though the same four values appear on the
# other vhsp units: each systemd unit reads its own environment at process
# start, there is no shared env file. Leaving them unset doesn't error --
# the job just runs and ships nowhere, which is the failure mode this block
# exists to prevent.
Environment=VHSP_BACKUP_SFTP_HOST=
Environment=VHSP_BACKUP_SFTP_PORT=22
Environment=VHSP_BACKUP_SFTP_USER=
Environment=VHSP_BACKUP_SFTP_PATH=/backup
ExecStart=__VHSP_HOME__/vhsp-control-plane/.venv/bin/vhsp backup process-requests

NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
