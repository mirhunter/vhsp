[Unit]
Description=VHSP admin web UI
After=network-online.target docker.service vhsp-docker-proxy.service
Wants=network-online.target vhsp-docker-proxy.service

[Service]
Type=simple
User=__VHSP_USER__
Group=__VHSP_USER__
WorkingDirectory=__VHSP_HOME__/vhsp-control-plane
# Talks to Docker through vhsp-docker-proxy.service's scoped API, not the
# raw socket -- __VHSP_USER__ is deliberately NOT in the `docker` group on a
# hardened deployment. See config.py's DOCKER_HOST_URL docstring and the
# control-plane README's "Docker socket exposure" section.
Environment=VHSP_DOCKER_HOST=tcp://127.0.0.1:2375
# 0.0.0.0, not a narrower interface: Traefik reaches this from inside its
# own container network namespace, where a loopback-only bind on the host
# isn't reachable at all. The real perimeter is the host firewall (ufw --
# port 8000 is never opened publicly), not this bind address. Don't
# "harden" this to 127.0.0.1 without first confirming how Traefik on that
# specific host reaches this process.
Environment=VHSP_ADMIN_BIND_HOST=0.0.0.0
Environment=VHSP_ADMIN_BIND_PORT=8000
# Trusts exactly one reverse-proxy hop (Traefik, terminating TLS and
# forwarding over plain HTTP). See config.py's ADMIN_TRUST_PROXY docstring
# for why this must stay off unless that's genuinely true -- with no proxy
# in front, it lets a client spoof its own source IP via X-Forwarded-For.
Environment=VHSP_ADMIN_TRUST_PROXY=1

# ---------------------------------------------------------------------
# Deployment-specific values below. Every line in this block is BLANK or
# a placeholder on purpose -- fill them in per host, and expect the
# installed copy under /etc/systemd/system to diverge from this file
# permanently as a result.
#
# That divergence is the point, and it has a consequence worth stating
# plainly: **never reinstall this unit by blindly copying the repo's
# version over a running deployment.** Doing so silently blanks the
# backup destination (backups then run and write nowhere useful) and
# resets the WebAuthn RP ID (every registered security key stops
# verifying, because WebAuthn binds credentials to that exact origin).
# Diff before overwriting, and carry these values across by hand.
#
# `vhsp doctor` does not check these -- it validates path constants, not
# unit environment.
# ---------------------------------------------------------------------

# The exact public hostname this admin UI is served on. Load-bearing for
# WebAuthn: an RP ID that doesn't match the origin makes every security
# key silently fail to verify, and an IP address can't be an RP ID at all.
Environment=VHSP_ADMIN_RP_ID=
# This host's public IP -- used to generate the suggested DNS records
# shown for each tenant.
Environment=VHSP_PLATFORM_PUBLIC_IP=
# HELO/myhostname identity for the outbound mail gateway. Should match
# the host's own forward and reverse DNS or deliverability suffers.
Environment=VHSP_MAILGW_HOSTNAME=
# 0 on a single-public-IP host (no separate management network), 1 on a
# deployment that has one. Controls whether tenant-admin session cookies
# are marked Secure -- see config.py's TENANT_ADMIN_MGMTWEB_EXISTS.
Environment=VHSP_TENANT_ADMIN_MGMTWEB_EXISTS=0
# Operator REST API, off unless explicitly turned on. When 0 the routes
# don't exist at all rather than returning 401.
Environment=VHSP_API_ENABLED=0
# Operator backup destination. Must match wherever `vhsp backup init`
# pushed its keys, and stay fixed afterwards -- changing it doesn't move
# existing snapshots, it just stops finding them for retention pruning.
Environment=VHSP_BACKUP_SFTP_HOST=
Environment=VHSP_BACKUP_SFTP_PORT=22
Environment=VHSP_BACKUP_SFTP_USER=
Environment=VHSP_BACKUP_SFTP_PATH=/backup
# gunicorn, not the `vhsp-admin` console script -- that's `app.run()`,
# Flask's own dev server, which prints its own warning against exactly
# this use (single request at a time, not hardened for anything actually
# reachable). Sessions are cookie-based (Flask's default), not
# server-side, so multiple worker processes need no shared state -- safe
# to run more than one. Wrapped in a shell so ${VHSP_ADMIN_BIND_HOST}/
# ${VHSP_ADMIN_BIND_PORT} (set via Environment= above) expand into
# --bind -- systemd's own ExecStart doesn't do shell-style substitution.
# --timeout 180, well above gunicorn's own 30s default: full tenant
# provisioning (create_tenant's six containers -- web/waf/db/sftp/mail/
# tenant-admin, plus volumes, DNS routing, and a fail2ban jail) is a
# single synchronous request that can genuinely take 60-90s. Without
# this, gunicorn SIGKILLs the worker mid-request, the client gets a 500,
# and the tenant is left silently created anyway (the docker calls
# already succeeded) -- discovered via the new operator API's own
# create_tenant round-trip test, but it was already a latent bug in this
# same route as reached from the web UI's own "New tenant" form.
ExecStart=/bin/sh -c 'exec __VHSP_HOME__/vhsp-control-plane/.venv/bin/gunicorn --workers 2 --timeout 180 --bind ${VHSP_ADMIN_BIND_HOST}:${VHSP_ADMIN_BIND_PORT} vhsp_ctl.web:app'
Restart=on-failure
RestartSec=2

# The control plane's provisioner shells out to sudo for mount/fstab
# hardening (see provisioner.py's _harden_host_dir) -- __VHSP_USER__'s
# passwordless sudo is what makes that work, same as the CLI path.
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
