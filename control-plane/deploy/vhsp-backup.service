[Unit]
Description=VHSP tenant backup sweep (operator + tenant destinations)
After=network-online.target docker.service vhsp-docker-proxy.service
Wants=network-online.target vhsp-docker-proxy.service

[Service]
Type=oneshot
User=__VHSP_USER__
Group=__VHSP_USER__
WorkingDirectory=__VHSP_HOME__/vhsp-control-plane
# Talks to Docker through vhsp-docker-proxy.service's scoped API, not the
# raw socket -- see vhsp-admin.service's own comment and the control-plane
# README's "Docker socket exposure" section for the full reasoning.
Environment=VHSP_DOCKER_HOST=tcp://127.0.0.1:2375
# Operator backup destination -- must match wherever `vhsp backup init`'s
# keys were generated and pushed to once, and stay fixed afterward: every
# tenant's op_remote_dir layout on the destination is <path>/<domain>/...,
# changing this out from under an existing destination just stops finding
# the tenant's own prior snapshots for retention pruning, it doesn't move
# anything.
# Deployment-specific: blank on purpose, filled in per host. The
# installed copy under /etc/systemd/system will therefore diverge from
# this file permanently -- **never reinstall this unit by copying the
# repo version over a running deployment**, or the backup destination is
# silently blanked and backups start writing nowhere useful. Diff first
# and carry the values across by hand.
Environment=VHSP_BACKUP_SFTP_HOST=
Environment=VHSP_BACKUP_SFTP_PORT=22
Environment=VHSP_BACKUP_SFTP_USER=
Environment=VHSP_BACKUP_SFTP_PATH=/backup
ExecStart=__VHSP_HOME__/vhsp-control-plane/.venv/bin/vhsp backup run-all

# The control plane's provisioner/backup modules shell out to sudo for
# mount hardening and privileged directory cleanup during restore -- same
# passwordless-sudo dependency as vhsp-admin.service.
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
